# AgentVPS Configuration Template

# Active Agent Framework (antigravity-cli, claude-code, aider, openhands, custom)
AGENT_TYPE=antigravity-cli

# LLM API Keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Git & GitHub Integration
GITHUB_TOKEN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Telegram Mobile Gateway (24/7 Phone Control)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# 1-Click Cloud Provider Tokens (Optional)
HETZNER_CLOUD_TOKEN=
DIGITALOCEAN_API_TOKEN=

# Web Terminal & Networking
ENABLE_WEB_TERMINAL=false
WEB_TERMINAL_PORT=7681
